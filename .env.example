# MongoDB
# Option A: provide a full connection string
# MONGODB_URI=mongodb+srv://user:password@your-cluster.mongodb.net/?appName=Cluster0
# Option B: provide the parts (used when MONGODB_URI is not set)
MONGODB_USER=
MONGODB_PASSWORD=
MONGODB_CLUSTER_HOST=your-cluster.xxxxx.mongodb.net
# Database name (optional, defaults to ecommerce-nextjs)
# MONGODB_DB=ecommerce-nextjs

# NextAuth
NEXTAUTH_SECRET=
# Required in production (e.g. https://your-domain.com) for OAuth callbacks
NEXTAUTH_URL=http://localhost:3000
GITHUB_ID=
GITHUB_SECRET=
GOOGLE_ID=
GOOGLE_SECRET=

# Comma-separated emails allowed to access /admin (product CRUD)
ADMIN_EMAILS=you@example.com

# Cloudinary (admin image uploads)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
# Optional upload folder
# CLOUDINARY_UPLOAD_FOLDER=styleshop/products

# Stripe
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Resend (order confirmation emails — optional in dev)
# Get an API key at https://resend.com
RESEND_API_KEY=
# For testing, Resend allows onboarding@resend.dev to your own verified inbox.
# For production, use a verified domain: StyleShop <orders@yourdomain.com>
RESEND_FROM_EMAIL=StyleShop <onboarding@resend.dev>

# App URL (no trailing slash — used for Stripe redirect URLs)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Optional — only needed if the API runs on a different origin.
# Leave unset in normal Next.js deploys (cart uses same-origin /api/cart).
# NEXT_PUBLIC_API_URL=https://api.example.com
